# Copy to backend/.env for local overrides. Never commit .env.
# Uvicorn reads PORT. Render sets PORT automatically.
PORT=8000

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hard limit on the raw upload body, in bytes (default 10 MiB).
MAX_UPLOAD_BYTES=10485760

# Decompression-bomb guard. Width times height must stay under this.
MAX_IMAGE_PIXELS=24000000

# Optional override. Defaults to the system temp directory / lumina-ai.
# TEMP_DIR=

# Optional path to a Zero-DCE++ state dict. Empty uses backend/models/zerodce_pp_epoch99.pth.
# ZERODCE_WEIGHTS=
ZERODCE_SCALE=12
MAX_INFERENCE_SIDE=1280
JPEG_QUALITY=92
